<?xml version="1.0" encoding="utf-8"?>
<!-- Platform cleartext is required for numeric LAN Hermes URLs (CIDR is not supported).
     LlmClient EndpointPolicy still refuses public HTTP. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
