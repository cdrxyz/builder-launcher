pkgname=builder-launcher
pkgver=0.1.0
pkgrel=1
pkgdesc='A keyboard desk for the builder.cdr.xyz account'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland' 'qt6-multimedia' 'xdg-desktop-portal')
makedepends=('gcc' 'make' 'qt6-svg')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/builder-launcher "$pkgdir/usr/bin/builder-launcher"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/builder-launcher.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/builder-launcher.svg"
  install -Dm644 "$startdir/builder-launcher.desktop" "$pkgdir/usr/share/applications/builder-launcher.desktop"
}
