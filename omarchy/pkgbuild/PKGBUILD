pkgname=builder-launcher
pkgver=0.1.0
pkgrel=1
pkgdesc='A keyboard desk for the builder.cdr.xyz account'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland' 'qt6-multimedia' 'qt6-multimedia-ffmpeg' 'xdg-desktop-portal')
makedepends=('gcc' 'make' 'qt6-svg')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/builder-launcher "$pkgdir/usr/bin/builder-launcher"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/builder-launcher.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/builder-launcher.svg"
  install -Dm644 "$startdir/builder-launcher.desktop" "$pkgdir/usr/share/applications/builder-launcher.desktop"
  install -Dm755 "$startdir/../bar/desk" "$pkgdir/usr/share/builder-launcher/bar/desk"
  install -Dm644 "$startdir/../bar/DeskBar.qml" "$pkgdir/usr/share/builder-launcher/bar/DeskBar.qml"
  install -Dm644 "$startdir/../bar/i18n/en.json" "$pkgdir/usr/share/builder-launcher/bar/i18n/en.json"
  install -Dm644 "$startdir/../bar/i18n/da.json" "$pkgdir/usr/share/builder-launcher/bar/i18n/da.json"
}
