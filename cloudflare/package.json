{
	"name": "builder-launcher-pwa",
	"private": true,
	"type": "module",
	"scripts": {
		"sync-assets": "rm -rf public && mkdir -p public && cp -R ../website/public/web/. public/",
		"test": "npm run sync-assets && node --experimental-strip-types --test test/*.test.ts",
		"typecheck": "tsc --noEmit",
		"dev": "npm run sync-assets && wrangler dev",
		"deploy": "npm run sync-assets && wrangler deploy"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.0.0",
		"typescript": "^5.9.2",
		"wrangler": "^4.34.0"
	},
	"allowScripts": {
		"esbuild@0.28.1": true,
		"workerd@1.20260918.1": true
	}
}
